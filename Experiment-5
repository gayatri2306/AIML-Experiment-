% Rules

% Topper: Marks >= 85
topper(Name) :-
    student(Name, Marks),
    Marks >= 85.

% Average Performer: Marks >= 50 and < 85
average(Name) :-
    student(Name, Marks),
    Marks >= 50,
    Marks < 85.

% Failed Student: Marks < 40
failed(Name) :-
    student(Name, Marks),
    Marks < 40.
